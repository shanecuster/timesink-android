<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml: the app's "identity card", read by Android before any of
  our code runs. It declares what the app is called, which screen opens first,
  and which special abilities (permissions) the app asks the user for.

  No permissions are declared yet. Later steps add them one at a time, each with
  a comment saying why it is needed: INTERNET when sync arrives, notifications
  for the low-battery message, and Usage Access for the phone's own screen time.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Timesink"
        android:allowBackup="false"
        android:supportsRtl="true">
        <!--
          allowBackup="false": do not copy the app's private data into Google's
          cloud backups. Screen-time data stays on the device unless the user
          turns on sync to their own server (a planned, opt-in feature).
        -->

        <!--
          The one screen. `exported="true"` is required for the screen that the
          launcher starts. The <intent-filter> says "this is the app's main
          entry point and should appear in the app drawer".
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
