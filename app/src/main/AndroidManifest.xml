<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml: the app's "identity card", read by Android before any of
  our code runs. It declares what the app is called, which screen opens first,
  and which special abilities (permissions) the app asks the user for.

  Permissions are added one at a time, each with a comment saying why it is
  needed. So far: INTERNET, for sync. Later: notifications for the low-battery
  message, and Usage Access for the phone's own screen time.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET: lets the app talk to the user's own CouchDB server when sync is
      turned on. Nothing is sent unless the master switch is on and server
      details have been typed in; the app contacts no other server.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      PACKAGE_USAGE_STATS ("Usage access"): lets the app read Android's own log of
      which app was in front and when, to record the phone's screen time. The
      user grants it by hand in Android's settings; the app records nothing until
      they do. Only app names and times are read, never anything inside an app.
      (Android marks this permission "protected", hence the lint note.)
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      RECEIVE_BOOT_COMPLETED: lets the one short scheduled check carry on after the
      phone restarts. It is only scheduled while the user has turned on "update in
      the background"; with that off, nothing is scheduled at all.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      POST_NOTIFICATIONS (Android 13+): so the app can say once, "Battery low.
      timesink has paused tracking and sync." The app asks when the user turns on
      background updates; if they decline, pausing still works, just silently.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Android 11+ hides other apps from this one unless it says what it needs to
      see. These two questions let the app read the name under each launchable
      app's icon, and tell the home screen (which is not "using an app") apart.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Timesink"
        android:allowBackup="false"
        android:supportsRtl="true">
        <!--
          allowBackup="false": do not copy the app's private data into Google's
          cloud backups. Screen-time data stays on the device unless the user
          turns on sync to their own server (a planned, opt-in feature).
        -->

        <!--
          The one screen. `exported="true"` is required for the screen that the
          launcher starts. The <intent-filter> says "this is the app's main
          entry point and should appear in the app drawer".
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The short check Android runs every 15 minutes while background updates
          are on (see Background.kt). Only Android itself may start it.
        -->
        <service
            android:name=".TickJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          Hears Android's "battery low" and "battery OK" announcements, so the
          paused notice can come straight away. It does one small thing and ends.
        -->
        <receiver
            android:name=".BatteryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
            </intent-filter>
        </receiver>

        <!--
          The Quick Settings tile that turns tracking and sync on or off from the
          notification shade. The permission lets only Android's shade bind to it.
        -->
        <service
            android:name=".TrackingTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_timesink"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
